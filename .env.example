# Create a key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-replace_with_your_key

# Sender must be a verified sender/domain in Brevo (Senders, Domains & Dedicated IPs).
BREVO_FROM_EMAIL=you@yourdomain.com
BREVO_FROM_NAME="Eben Kwete Portfolio"

# Destination inbox for every portfolio enquiry.
CONTACT_TO_EMAIL=kweteeben@gmail.com
